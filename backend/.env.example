# Copy to .env and edit. All values are optional.
# Models live OUTSIDE the backend code; default is ../model_registry
# MODEL_REGISTRY_DIR=../model_registry
# KNOWLEDGE_BASE_DIR=./knowledge_base
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Preprocessing enhancement (proposal step 2): noise reduction (median filter)
# + contrast adjustment (CLAHE) before resize/normalize. Default on.
# PREPROCESS_ENHANCE=true

# Protect model/knowledge admin endpoints (send header X-Admin-Token)
# ADMIN_TOKEN=change-me
# Allow model folders to ship their own adapter.py (executes code!)
# ALLOW_MODEL_PLUGINS=false

# Retrieval. tfidf = offline default. For dense embeddings:
# EMBEDDER=sentence-transformers
# RETRIEVAL_MIN_SCORE=0.75
EMBEDDER=tfidf
RETRIEVAL_MIN_SCORE=0.15
RETRIEVAL_TOP_K=2
MAX_FINDINGS=3

# Report generation: template (offline, default) or llm (any OpenAI-compatible API)
GENERATOR=template
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
